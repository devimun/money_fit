require 'dotenv'
require 'shellwords'
require 'yaml'

# CI-provided variables win because Dotenv.load never overwrites an existing
# environment entry. The local file is intentionally ignored by Git.
local_fastlane_env = File.expand_path('../../.fastlane.env.local', __dir__)
Dotenv.load(local_fastlane_env) if File.file?(local_fastlane_env)

def repository_root
  File.expand_path('../..', __dir__)
end

def dart_define_values
  amplitude_key = ENV.fetch('AMPLITUDE_PROD_API_KEY', '').strip
  values = {
    'AMPLITUDE_ENABLED' => ENV.fetch(
      'AMPLITUDE_ENABLED',
      amplitude_key.empty? ? 'false' : 'true'
    ).strip,
    'ANALYTICS_ENV' => ENV.fetch('ANALYTICS_ENV', 'prod').strip,
    'AMPLITUDE_SERVER_ZONE' => ENV.fetch('AMPLITUDE_SERVER_ZONE', 'us').strip,
    'MONEY_FIT_APP_FLAVOR' => ENV.fetch('MONEY_FIT_APP_FLAVOR', 'production').strip,
    'FIREBASE_ENABLED' => ENV.fetch('FIREBASE_ENABLED', 'true').strip,
    'SUPABASE_URL' => ENV.fetch('SUPABASE_URL', '').strip,
    'SUPABASE_ANON_KEY' => ENV.fetch('SUPABASE_ANON_KEY', '').strip,
    'IOS_APP_ID' => ENV.fetch('IOS_APP_ID', '').strip
  }
  values['AMPLITUDE_API_KEY'] = amplitude_key unless amplitude_key.empty?
  values.reject { |_key, value| value.empty? }
end

def flutter_dart_defines
  dart_define_values.map do |key, value|
    "--dart-define=#{Shellwords.shellescape("#{key}=#{value}")}"
  end.join(' ')
end

def validate_store_metadata
  Dir.chdir(repository_root) do
    sh 'dart run tool/validate_store_metadata.dart'
  end
end

default_platform(:android)

platform :android do
  
  # ==========================================
  # 1. 개발/테스트용 (기존 코드 유지)
  # ==========================================
  desc "pubspec.yaml 버전을 기준으로 내부 테스트 배포"
  lane :beta do
    pubspec = YAML.load_file(File.join(File.dirname(__FILE__), "../../pubspec.yaml"))
    version_string = pubspec['version']
    version_name = version_string.split('+')[0]
    build_number = version_string.split('+')[1]

    puts "------------------------------------------------"
    puts "🤖 Project MoneyFit 안드로이드 내부 테스트 배포"
    puts "📌 버전: #{version_name} (빌드코드: #{build_number})"
    puts "------------------------------------------------"

    Dir.chdir(repository_root) do
      # Do not print this command: it can contain the Amplitude ingestion key.
      sh "flutter build appbundle --release #{flutter_dart_defines}", log: false
    end

    upload_to_play_store(
      track: 'internal',
      aab: '../build/app/outputs/bundle/release/app-release.aab',
      skip_upload_screenshots: true, # 빠른 배포를 위해 스킵
      skip_upload_images: true       # 빠른 배포를 위해 스킵
    )
  end
  
  # ==========================================
  # 2. 메타데이터 업데이트용 (텍스트만)
  # ==========================================
  desc "앱 빌드 없이 스토어 텍스트 정보만 업데이트"
  lane :update_metadata do
    validate_store_metadata
    upload_to_play_store(
      track: 'internal',
      skip_upload_aab: true,           # 앱은 안 올림
      skip_upload_images: true,        # 이미지 스킵 (빠른 업데이트)
      skip_upload_screenshots: true,   # 스크린샷 스킵
      skip_upload_metadata: false,     # 텍스트 올림!
      skip_upload_changelogs: true     # changelog는 릴리즈 때
    )
  end

  desc "Play Console을 변경하지 않고 스토어 메타데이터를 검증"
  lane :validate_metadata do
    validate_store_metadata
    upload_to_play_store(
      validate_only: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true
    )
  end

  # ==========================================
  # 2-1. 이미지 업데이트용 (스크린샷 바꿨을 때만)
  # ==========================================
  desc "스크린샷/아이콘 등 이미지를 바꿨을 때 사용"
  lane :update_images do
    upload_to_play_store(
      track: 'internal',
      skip_upload_aab: true,
      skip_upload_images: false,       # 이미지 올림!
      skip_upload_screenshots: false,  # 스크린샷 올림!
      skip_upload_metadata: true,      # 텍스트는 스킵
      skip_upload_changelogs: true,
      sync_image_upload: true          # 로컬과 동기화 (삭제+업로드)
    )
  end

  # ==========================================
  # 3. 정식 출시용 (Internal -> Production 승격)
  # ==========================================
  desc "내부 테스트의 최신 빌드를 정식 출시(Production)로 승격 + 스토어 정보 반영"
  lane :release do
    pubspec = YAML.load_file(File.join(File.dirname(__FILE__), "../../pubspec.yaml"))
    version_string = pubspec['version']
    build_number = version_string.split('+')[1].to_i

    upload_to_play_store(
      track: 'internal',              # 출발지: 내부 테스트 트랙
      track_promote_to: 'production', # 목적지: 프로덕션 트랙
      skip_upload_aab: true,          # 새 파일 업로드 안 함 (있는 거 씀)
      version_code: build_number,     # changelog 버전 지정
      
      # 정식 출시니까 스토어 정보도 확실하게 업데이트
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_metadata: false,
      sync_image_upload: true          # 로컬에 없는 이미지는 삭제
    )
  end
end
